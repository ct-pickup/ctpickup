# Same Supabase project as the Next.js app (Auth → URL allowlist must include your Expo scheme / EAS URLs).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Deployed Next.js origin (no trailing slash). Used for /api/pickup/public, /api/mobile/push-token, /api/auth/email-exists.
EXPO_PUBLIC_SITE_URL=https://your-domain.com

# Optional fallback if app.json extra.eas.projectId is missing (already set in app.json for this project).
# EXPO_PUBLIC_EAS_PROJECT_ID=99b5a587-1f98-4258-8413-fe6f555f52bf
#
# Push notifications do NOT work in Expo Go — use `eas build` (TestFlight/App Store) or a dev client.
# Register tokens only from standalone/bare builds; server ignores storeClient (Expo Go) tokens.
