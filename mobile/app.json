{
  "expo": {
    "name": "CT",
    "description": "Soccer pickup & tournaments",
    "slug": "ctpickup-mobile",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ctpickup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ctpickup.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Show pickup sessions near you.",
        "NSContactsUsageDescription": "Competitive Together uses your contacts so you can pick friends to invite. Your contacts are never uploaded.",
        "CFBundleDisplayName": "CT"
      },
      "buildNumber": "51"
    },
    "android": {
      "package": "com.ctpickup.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "Competitive Together uses your contacts so you can pick friends to invite. Your contacts are never uploaded."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#14E4FC",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/ct-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Competitive Together to use Face ID to unlock the app."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show pickup sessions near you."
        }
      ],
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Competitive Together uses your photos so you can add a profile photo other players will recognize.",
          "cameraPermission": "Competitive Together uses your camera so you can take a profile photo other players will recognize."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "99b5a587-1f98-4258-8413-fe6f555f52bf"
      }
    },
    "owner": "omeedpooyas-organization"
  }
}
