# Copy to mobile/.env.development.local (gitignored) to run the app against the DEV Supabase project.
# `npx expo start` loads .env.development.local ahead of .env, so your normal .env stays untouched.
# Delete or rename the file to go back. Restart with `npx expo start -c` after any change.
EXPO_PUBLIC_SUPABASE_URL=https://plratvhywezrtedwipsm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<dev anon key: Dashboard > Project Settings > API>
# Your local Next.js server (see docs/dev-environment.md). Simulator: http://localhost:3000. Phone: http://<mac LAN ip>:3000
EXPO_PUBLIC_SITE_URL=http://localhost:3000
